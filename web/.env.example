# URL gốc của n8n (không có dấu / ở cuối). Web gọi <URL>/webhook/biascan-search và /webhook/biascan-chat
NEXT_PUBLIC_N8N_BASE_URL=https://n8n.thuanbt.id.vn
# Token công khai gửi trong header x-biascan-token (lộ ở trình duyệt — chỉ để chặn gọi bừa, chống lạm dụng nhờ rate limit theo IP)
NEXT_PUBLIC_BIASCAN_TOKEN=
