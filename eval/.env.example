# Gemini (aistudio.google.com) — chỉ cần cho text_query và run_eval --via direct
GEMINI_API_KEY=
# Supabase session pooler — chỉ cần cho run_eval --via direct
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Khớp bảng app_config
EMBED_MODEL=gemini-embedding-2
EMBED_DIMS=768
OCR_MODEL=gemini-2.5-flash
# Model viết câu truy vấn text_query; bỏ trống thì dùng OCR_MODEL
CHAT_MODEL=gemini-2.5-flash
# task_type khi embed truy vấn (gemini-embedding-2 không nhận task_type nên tự bỏ qua)
EMBED_QUERY_TASK_TYPE=RETRIEVAL_QUERY
# run_eval --via n8n
N8N_BASE_URL=https://n8n.thuanbt.id.vn
BIASCAN_TOKEN=
# Tuỳ chọn: dùng file train.jsonl có sẵn thay vì tải từ HF
# BIASCAN_DATASET_JSONL=
